# TLS termination in front of Harness² Workbench (used by deploy/compose.yaml).
# Replace workbench.example.com with your hostname; Caddy obtains and renews the certificate.
# In h2workbench.toml set:
#   [server] public_url = "https://workbench.example.com"
#            allowed_hosts = ["workbench.example.com"]
#            trusted_proxies = ["<the ingress container's subnet, e.g. 172.16.0.0/12>"]
# The Workbench sets its own security headers (CSP, nosniff, frame denial); Caddy only adds HSTS.

workbench.example.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy workbench:8722 {
		header_up X-Forwarded-Proto {scheme}
		# Server-sent events (live job logs) must not be buffered.
		flush_interval -1
	}
}
